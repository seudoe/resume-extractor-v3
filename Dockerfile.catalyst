# Catalyst AppSail variant for resume-extractor-v3
# Runs in /app, HOME=/opt/home, world-writable directories because AppSail runs as an arbitrary UID.
# Listens on $PORT (defaults to 9000 on AppSail).

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    HF_HOME=/opt/hf \
    TOKENIZERS_PARALLELISM=false \
    OMP_NUM_THREADS=2 \
    RX3_TORCH_THREADS=2 \
    RX3_ENABLE_GLINER=1 \
    HOME=/opt/home \
    PATH=/app/.venv/bin:$PATH

# System dependencies: tesseract for OCR fallback, libgomp for torch OpenMP runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libgomp1 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.22 /uv /bin/uv
WORKDIR /app

# 1) Dependencies only (cached layer): CPU torch on Linux comes from pytorch-cpu index in uv.lock
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra gliner

# 2) Code, schema types, and the versioned LoRA adapter
COPY src ./src
COPY types ./types
COPY scripts ./scripts
COPY models/adapters ./models/adapters
COPY models/MODEL_CHECKSUMS.txt ./models/MODEL_CHECKSUMS.txt
RUN uv sync --frozen --no-dev --extra gliner

# 3) Bake the pinned base model into the image at build time (runs offline afterwards)
RUN python scripts/fetch_models.py
ENV HF_HUB_OFFLINE=1

COPY GIT_SHA* ./
ARG GIT_SHA=unknown
ENV RX3_GIT_SHA=$GIT_SHA

# Ensure directories exist and are world-writable for AppSail's non-root container runtime
RUN mkdir -p /app/data /opt/home /opt/hf \
 && chmod -R a+rwX /app /opt/home /opt/hf

EXPOSE 9000

CMD ["sh", "-c", "export HOME=/opt/home && uvicorn rx3.api:app --host 0.0.0.0 --port ${PORT:-9000} --workers 1"]

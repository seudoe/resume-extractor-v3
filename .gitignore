.venv/
__pycache__/
*.pyc
.env

# data: keep manifests, ignore raw/bulky content
data/**
!data/**/
!data/**/*.md
!data/**/manifest*.json
!data/**/.gitkeep
!data/splits/*.json

models/**
!models/.gitkeep
!models/MANIFEST.md

# reports: keep markdown summaries, ignore large json artifacts
reports/*.json
!reports/.gitkeep

.pytest_cache/
.ruff_cache/
*.egg-info/

# big binaries wherever they land (models, checkpoints, adapters, exports)
*.gguf
*.safetensors
*.pt
*.pth
*.bin
*.onnx
*.ckpt
*.npz
*.parquet
data/train/
data/synthetic/*
!data/synthetic/.gitkeep
data/cache/
models/gliner-lora/
runs/

# the small LoRA adapter is versioned (see models/MANIFEST.md); everything else under models/ stays ignored
!models/adapters/
!models/adapters/**
!models/adapters/**/*.safetensors
